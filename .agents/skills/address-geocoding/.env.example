# ==============================================================================
# Address Geocoding Skill - 환경 변수 샘플 (.env.example)
# ==============================================================================
# 이 파일을 복사하여 '.env' 파일로 이름을 변경한 뒤 실제 인증키를 입력하세요.
# ==============================================================================

# 국토교통부 VWorld Geocoder 및 공간 검색 API 인증키
# 발급처: https://www.vworld.kr
VWORLD_API_KEY=YOUR_VWORLD_API_KEY_HERE

# API 신청 시 등록한 도메인 URL (기본값: http://localhost)
VWORLD_DOMAIN=http://localhost
